# Copy this file to backend.tf after creating the S3 bucket and DynamoDB table.
# Do not use local Terraform state for real deploys, because state can contain
# sensitive metadata.

terraform {
  backend "s3" {
    bucket         = "replace-with-your-terraform-state-bucket"
    key            = "todoapp-api/prod/terraform.tfstate"
    region         = "sa-east-1"
    encrypt        = true
    dynamodb_table = "replace-with-your-terraform-lock-table"
  }
}
